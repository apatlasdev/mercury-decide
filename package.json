  "type": "module",
  "license": "MIT",
  "author": "apatlasdev",
  "private": true,
  "bin": {
    "mercury-decide": "bin/decide.mjs",
    "mercury-decide-mcp": "bin/mcp.mjs",
    "mercury-route": "bin/route.mjs"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
